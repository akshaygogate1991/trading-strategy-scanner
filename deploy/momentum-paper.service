[Unit]
Description=Monthly momentum paper portfolio (no orders - paper only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=trader
WorkingDirectory=/home/trader/trading-strategy
ExecStart=/home/trader/trading-strategy/.venv/bin/python momentum_paper.py
# the separate GOLDBEES paper holding (gold_paper.py), bought once and kept
ExecStart=/home/trader/trading-strategy/.venv/bin/python gold_paper.py
# the monthly rebalance downloads ~2,400 stocks from Yahoo; normal days take seconds
TimeoutStartSec=45min
Environment=PYTHONUNBUFFERED=1 PYTHONIOENCODING=utf-8
